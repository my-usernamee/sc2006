# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must NEVER be committed.
# Do NOT put real secrets in this file - it IS committed to git.

# Use a NEW empty Neon (or other PostgreSQL) database for the presentation.
# Migrations create tables only; accounts and listings are entered in the app.
DATABASE_URL=""

# Long random secret used to sign verified location selections (keep existing key name), e.g. `openssl rand -base64 48`
JWT_SECRET=""

# --- OneMap ---
# Recommended: OneMap account credentials. The backend fetches and caches a
# token itself, and refreshes it automatically when it expires.
ONEMAP_EMAIL=""
ONEMAP_PASSWORD=""
# Optional alternative: a token you already hold. OneMap tokens expire after
# about 3 days, so this is mainly useful for a quick test. If this is set it
# takes priority over the email/password above.
ONEMAP_TOKEN=""

# Server port
PORT=3000

# Local development origin. On Render, omit CORS_ORIGIN to use its public URL.
# For a custom domain, set this to the exact HTTPS origin without a trailing slash.
CORS_ORIGIN="http://localhost:5173"

# Optional: absolute persistent upload directory on your hosting service.
# Render blueprint uses /var/data/uploads; leave blank for local development.
UPLOAD_DIR=""
